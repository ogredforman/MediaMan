{
  "name": "mediaman",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "web",
    "desktop"
  ],
  "scripts": {
    "build": "dotnet build server/MediaMan.sln -c Release && npm run build -w web && npm run build -w desktop",
    "test": "dotnet test server/MediaMan.sln && npm test -w web && npm test -w desktop",
    "test:perf": "dotnet test --project server/tests/MediaMan.Server.Tests -- --explicit only",
    "fixture:database": "dotnet test --project server/tests/MediaMan.Data.Tests -- --explicit only --filter-class \"*UpgradeFixtureWriter\"",
    "lint": "eslint . && dotnet format server/MediaMan.sln --verify-no-changes",
    "publish:server:win": "node scripts/publish-server.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "package:win": "node scripts/package-win.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.71.0"
  }
}
