<!-- The packaged Windows server (PLAN 2.5.1): one self-contained exe from a Release build, so no dev code ships
     (SPEC §8 setup [P]). Not trimmed: EF Core and the reflection-based JSON aren't trim-safe. scripts/publish-server.mjs
     runs this and adds the bundled ffprobe beside it. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <!-- Not hosted in IIS, and no static web assets: ship only the exe. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- The dev configuration never ships (SPEC §8 setup [P]). -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
